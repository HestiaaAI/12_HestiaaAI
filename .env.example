SECRET_KEY=replace-with-a-long-random-django-secret-key
OPENAI_API_KEY=sk-dummy-your-key-here

# Optional: used ONLY with --settings=hestia_config.settings.shared
# Copy the session-pooler URI from Supabase; URL-encode the database password.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require

# H01: local development prints verification emails to the server terminal.
# Match this origin to the local server port, or the actual HTTPS staging site.
ACCOUNT_PUBLIC_ORIGIN=http://127.0.0.1:8012
# Staging registration stays closed until real SMTP and HTTPS origin are ready.
STAGING_SIGNUP_ENABLED=False
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=
