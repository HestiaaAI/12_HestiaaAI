SECRET_KEY=replace-with-a-long-random-django-secret-key
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OPENAI_API_KEY=sk-dummy-your-key-here

# A6 Person 2 — local Hugging Face Brain Dump (weights download on first use)
HF_TOKEN=
# Optional cache location; keep it ignored and allow disk space for model weights.
HF_HOME=model_cache/huggingface
# Use local inference by default; set mock only for an explicitly labeled UI demo.
HESTIA_BRAIN_DUMP_BACKEND=local
# Optional Person 3 function returning {"steps": ["..."], "error": null}.
# HESTIA_TASK_BREAKDOWN_CALLABLE=workflows.services.task_breakdown.break_down_task
HF_BRAIN_DUMP_MODEL=TinyLlama/TinyLlama-1.1B-Chat-v1.0
HF_BRAIN_DUMP_DEVICE=cpu
HF_BRAIN_DUMP_MAX_NEW_TOKENS=220
HF_BRAIN_DUMP_SHOT_MODE=few

# A4 production: add the exact hostname shown in your PythonAnywhere Web tab.
# No scheme, slash, port, or wildcard. Local production testing works by default.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Optional: used ONLY with --settings=hestia_config.settings.shared
# Copy the session-pooler URI from Supabase; URL-encode the database password.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require

# H01: local development prints verification emails to the server terminal.
# Match this origin to the local server port, or the actual HTTPS staging site.
ACCOUNT_PUBLIC_ORIGIN=http://127.0.0.1:8012
# Staging registration stays closed until real SMTP and HTTPS origin are ready.
STAGING_SIGNUP_ENABLED=False
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=
